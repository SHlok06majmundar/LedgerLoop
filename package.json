{
  "name": "ledgerloop",
  "private": true,
  "description": "Multi-tenant accounts-receivable and payment reconciliation platform",
  "packageManager": "pnpm@10.13.1",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "setup": "pnpm install && pnpm build:packages",
    "build:packages": "pnpm --filter @ledgerloop/shared-types --filter @ledgerloop/validation build",
    "dev:api": "pnpm --filter @ledgerloop/api dev",
    "dev:web": "pnpm --filter @ledgerloop/web dev",
    "dev:mobile": "pnpm --filter @ledgerloop/mobile dev",
    "test:e2e": "pnpm --filter @ledgerloop/api build && pnpm --filter @ledgerloop/web build && pnpm --filter @ledgerloop/e2e test",
    "build": "turbo run build",
    "dev": "turbo run dev",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "devDependencies": {
    "@types/jest": "^30.0.0",
    "@types/node": "^22.20.5",
    "jest": "^30.5.2",
    "prettier": "^3.9.10",
    "sharp": "^0.34.5",
    "ts-jest": "^29.4.15",
    "turbo": "^2.11.10",
    "typescript": "~5.8.3"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "sharp",
      "@nestjs/core",
      "@node-rs/argon2"
    ]
  }
}

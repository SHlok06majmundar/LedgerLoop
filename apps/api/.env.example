NODE_ENV=development
PORT=4000

# PostgreSQL (e.g. Neon, Supabase, Render Postgres, or a local server)
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/ledgerloop?schema=public&sslmode=require

# Redis for BullMQ (e.g. Upstash, Redis Cloud, Render Key Value)
REDIS_URL=rediss://default:PASSWORD@HOST:6379

WEB_ORIGINS=http://localhost:3000
APP_URL=http://localhost:3000

# generate with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_ACCESS_SECRET=
JWT_ACCESS_TTL_SECONDS=900
REFRESH_TOKEN_TTL_DAYS=30

# S3-compatible object storage (e.g. Cloudflare R2, AWS S3)
STORAGE_ENDPOINT=https://ACCOUNT_ID.r2.cloudflarestorage.com
STORAGE_REGION=auto
STORAGE_BUCKET=ledgerloop
STORAGE_ACCESS_KEY_ID=
STORAGE_SECRET_ACCESS_KEY=

# Email (e.g. Resend/Brevo/SES SMTP)
SMTP_URL=smtps://USER:PASSWORD@smtp.example.com:465
EMAIL_FROM=LedgerLoop <billing@yourdomain.com>

SENTRY_DSN=
LOG_LEVEL=debug

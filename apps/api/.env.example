NODE_ENV=development
PORT=4000

# MongoDB Atlas connection string (no database name in the URI)
MONGODB_URI="mongodb+srv://USER:PASSWORD@cluster0.example.mongodb.net"
MONGODB_DB=ledgerloop
MONGODB_TEST_DB=ledgerloop_test

# Comma-separated list of allowed frontend origins
WEB_ORIGINS=http://localhost:3000
APP_URL=http://localhost:3000

# generate with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_ACCESS_SECRET=
JWT_ACCESS_TTL_SECONDS=900
REFRESH_TOKEN_TTL_DAYS=30
REFRESH_REUSE_GRACE_SECONDS=30

# Statements and PDFs are stored here; relative paths resolve from apps/api
UPLOAD_DIR=uploads
MAX_UPLOAD_MB=10

# SMTP. For Gmail use an app password: https://myaccount.google.com/apppasswords
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=you@gmail.com
SMTP_PASS=
EMAIL_FROM="LedgerLoop <you@gmail.com>"

# Run background jobs and scheduled tasks inside the API process (handy locally)
RUN_WORKER=true
RUN_SCHEDULER=true
WORKER_CONCURRENCY=2

SENTRY_DSN=
LOG_LEVEL=debug
